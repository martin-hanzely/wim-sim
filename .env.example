# Copy to .env and adjust. Compose reads .env automatically.
#
# TimescaleDB defaults to 5433 rather than 5432: a local PostgreSQL on 5432 is the common case, and
# silently connecting to the WRONG database is far worse than a refused connection.

MQTT_PORT=1883
MQTT_WS_PORT=9001

PGPORT=5433
PGUSER=wimsim
PGPASSWORD=wimsim
PGDATABASE=wimsim

OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_METRICS_PORT=8889

PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200

GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
