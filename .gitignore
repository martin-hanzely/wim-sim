.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# generated runs and results -- regenerable from config + seed by construction
data/synthetic/*
!data/synthetic/.gitkeep
data/results/*
!data/results/.gitkeep

# real recordings are large and not ours to redistribute
data/real/*
!data/real/.gitkeep
!data/real/EXAMPLE/
.ruff_cache/

# local compose overrides
.env

# export/ IS tracked, CSVs included. They are NOT regenerable by someone who clones this repo --
# data/results/ is ignored, so the parquets they are built from are not here. The export is the
# deliverable for a reader without the runs.
